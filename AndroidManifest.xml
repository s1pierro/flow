<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.s1pierro.flow"
    android:versionCode="14"
    android:versionName="0.10">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Accès à tous les fichiers : les réglages de l'interface vivent dans le
         stockage partagé, et les applications filles (l'explorateur) en ont besoin.
         MANAGE_EXTERNAL_STORAGE pour Android 11 et plus ; avant, l'écriture classique. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Le réseau : la lecture de flux (web radio). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- La lecture continue hors de l'application : service au premier plan, avec sa
         notification, et l'appareil (processeur, Wi-Fi) tenu éveillé pendant la lecture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:label="Flow"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hasCode="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">

            <meta-data android:name="android.app.lib_name" android:value="flow" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="fr.s1pierro.flow.Lecture"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
